;&amp;#2339; &amp;#2325;&amp;#2375; &amp;#2330;&amp;#2354;&amp;#2344;&amp;#2375; &amp;#2357;&amp;#2366;&amp;#2354;&amp;#2375; &amp;#2361;&amp;#2367;&amp;#2360;&amp;#2381;&amp;#2360;&amp;#2379;&amp;#2306;, &amp;#2332;&amp;#2376;&amp;#2360;&amp;#2375; &amp;#2327;&amp;#2361;&amp;#2344;&amp;#2375; &amp;#2350;&amp;#2375;&amp;#2306; &amp;#2347;&amp;#2306;&amp;#2360; &amp;#2360;&amp;#2325;&amp;#2340;&amp;#2375; &amp;#2361;&amp;#2376;&amp;#2306;&amp;#2404;&amp;#10;&amp;#10; &amp;#2313;&amp;#2330;&amp;#2367;&amp;#2340; &amp;#2357;&amp;#2381;&amp;#2351;&amp;#2325;&amp;#2381;&amp;#2340;&amp;#2367;&amp;#2327;&amp;#2340; &amp;#2360;&amp;#2369;&amp;#2352;&amp;#2325;&amp;#2381;&amp;#2359;&amp;#2366; &amp;#2313;&amp;#2346;&amp;#2325;&amp;#2352;&amp;#2339; &amp;#2346;&amp;#2361;&amp;#2344;&amp;#2375;&amp;#2306;, &amp;#2332;&amp;#2376;&amp;#2360;&amp;#2375; &amp;#2330;&amp;#2350;&amp;#2337;&amp;#2364;&amp;#2375; &amp;#2325;&amp;#2375; &amp;#2342;&amp;#2360;&amp;#2381;&amp;#2340;&amp;#2366;&amp;#2344;&amp;#2375;&amp;#2404;&amp;#10;&amp;#10; &amp;#2311;&amp;#2360; &amp;#2325;&amp;#2366;&amp;#2350; &amp;#2325;&amp;#2375; &amp;#2354;&amp;#2367;&amp;#2319; &amp;#2360;&amp;#2361;&amp;#2368; &amp;#2313;&amp;#2346;&amp;#2325;&amp;#2352;&amp;#2339; &amp;#2325;&amp;#2366; &amp;#2313;&amp;#2346;&amp;#2351;&amp;#2379;&amp;#2327; &amp;#2325;&amp;#2352;&amp;#2375;&amp;#2306;&amp;#2404;  &amp;#2342;&amp;#2370;&amp;#2360;&amp;#2352;&amp;#2375; &amp;#2358;&amp;#2348;&amp;#2381;&amp;#2342;&amp;#2379;&amp;#2306; &amp;#2350;&amp;#2375;&amp;#2306;, &amp;#2352;&amp;#2367;&amp;#2306;&amp;#2330; &amp;#2325;&amp;#2379; &amp;#2361;&amp;#2341;&amp;#2380;&amp;#2337;&amp;#2364;&amp;#2375; &amp;#2325;&amp;#2368; &amp;#2340;&amp;#2352;&amp;#2361; &amp;#2311;&amp;#2360;&amp;#2381;&amp;#2340;&amp;#2375;&amp;#2350;&amp;#2366;&amp;#2354; &amp;#2325;&amp;#2352;&amp;#2344;&amp;#2375; &amp;#2325;&amp;#2368; &amp;#2325;&amp;#2379;&amp;#2358;&amp;#2367;&amp;#2358; &amp;#2344; &amp;#2325;&amp;#2352;&amp;#2375;&amp;#2306;&am