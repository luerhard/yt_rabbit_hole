  node [
    id 194
    label "e2XAknJFYew"
    step 0
    date "2015-04-06T16:28:15Z"
    title "The Kramer Family Receives Tourette Syndrome Associations 2015 Shining Star Award"
    description "On March 5, 2015, at the second annual &#8220;Hollywood Heals: Spotlight on Tourette Syndrome&#8221; event held in West Hollywood at the House of Blues, the Tourette Association honored the Kramer Family: Derek and Nancy, and their sons Justin and Jordan, with the 2015 Shining Star Award, &#34;for outstanding contributions toward shining the spotlight on awareness and understanding of Tourette Syndrome.&#8221;"
    channeltitle "Tourette Association of America"
