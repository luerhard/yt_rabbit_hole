  [
    id 327
    label "MGoNE85DG20"
    step 0
    date "2021-12-16T02:54:11Z"
    title "George Floyd Family Attorney Reacts to Derek Chauvins Guilty Plea"
    description "Derek Chauvin, the former Minneapolis police officer who was convicted of murder, pled guilty in federal court today to civil rights charges related to George Floyd&amp;#8217;s death.  &amp;#10;&amp;#10;This was the first time Chauvin publicly admitted his role in Floyd&amp;#8217;s death. &amp;#10;&amp;#10;The guilty plea comes 18 months after the former officer was caught on video kneeling on Floyd&amp;#8217;s neck and back for nine minutes and 26 seconds. &amp;#10;&amp;#10;Antonio Romanucci, one of the attorneys representing the Floyd family in their civil suit against the city of Minneapolis, joins Yodit Tewolde on &amp;#8220;Making the Case&amp;#8221; to react to Chauvin&amp;#8217;s guilty plea. &amp;#10;&amp;#10;All this and more on &amp;#8220;Making the Case.&amp;#8221; &amp;#10;&amp;#10;To watch BNC programming, visit https://bnc.tv/how-to-watch/ &amp;#10;&amp;#10;Follow BNC on social media: &amp;#10;Facebook: https://www.facebook.com/BNCNews  &amp;#10;Twitter: https://twitter.com/BNCNews  &amp;#10;Instagram: https://www.instagram.com/bncnews/?hl=en &amp;#10; &amp;#10;#DerekChauvin #GeorgeFloyd #MakingTheCase"
    channeltitle "BNC News"
    channelid "UCAPlkRGvp4_JnsIyOJmpgDg"
    favcount 0
    viewcount 2225
    likecount 74
    commentcount 33
