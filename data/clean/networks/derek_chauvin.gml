  [
    id 309
    label "z4NibvIC4GI"
    step 0
    date "2021-04-20T22:21:41Z"
    title "Ex-police officer Derek Chauvin found guilty of murdering George Floyd"
    description "Subscribe to our YouTube channel for free here: &amp;#10;https://sc.mp/clipssubscribe&amp;#10;&amp;#10;Derek Chauvin, a former Minneapolis police officer, was found guilty of all charges &amp;#8212;  two counts of murder and one count of manslaughter &amp;#8212; in the death of George Floyd. The jury reached a verdict on April 20, 2021, after a trial that lasted three weeks. Floyd was killed during an arrest by Chauvin and three other officers in May 2020. The video of Floyd pleading &amp;#8220;I can&amp;#8217;t breathe&amp;#8221; as Chauvin knelt on his neck triggered worldwide protests against police brutality and racism. &amp;#10;&amp;#10;Video source: Reuters/Pool&amp;#10;&amp;#10;Read more:&amp;#10;https://www.scmp.com/news/world/united-states-canada/article/3130365/derek-chauvin-found-found-guilty-murder-george&amp;#10;&amp;#10;https://www.scmp.com/news/world/united-states-canada/article/3130388/whats-next-derek-chauvin-after-being-found-guilty&amp;#10;&amp;#10;Support us:&amp;#10;https://subscribe.scmp.com&amp;#10;&amp;#10;Follow us on:&amp;#10;Website:  https://www.scmp.com&amp;#10;Facebook:  https://facebook.com/scmp&amp;#10;Twitter:  https://twitter.com/scmpnews&amp;#10;Instagram:  https://instagram.com/scmpnews&amp;#10;Linkedin:  https://www.linkedin.com/company/south-china-morning-post"
    channeltitle "SCMP Clips"
    channelid "UC4zULhjsUIEDTt7ZlC1Kk1Q"
    favcount 0
    viewcount 1739
