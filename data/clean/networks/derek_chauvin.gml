  node [
    id 31
    label "eaml9K08OyY"
    step 0
    date "2021-04-05T22:11:46Z"
    title "How Much Derek Chauvins Wife Got in Divorce Settlement"
    description "Derek Chauvin is facing life in prison if convicted of murdering George Floyd, but the life he lived before that fateful day is already over. Last year, protestors gathered outside his home following Floyd&#8217;s death, with some scrawling &#8220;murderer&#8221; on his driveway. Just days later, his wife of 10 years, Kellie Chauvin, filed for divorce, and in a statement expressed sympathy for Floyd&#8217;s family. Divorce court documents show that in their final settlement, Kellie got over $700,000. #InsideEdition"
    channeltitle "Inside Edition"
    channelid "UC9k-yiEpRHMNVOnOi_aQK8w"
