  [
    id 85
    label "rEX0vQVfK6g"
    step 0
    date "2022-03-14T13:09:21Z"
    title "Nanotechnology Platform Center in Japan, National Institute of Materials Science (NIMS)"
    description "The National Institute for Materials Science (NIMS) in Japan is one of the core research institutes in the field of material science. NIMS is leading the Nanotechnology Platform Japan (NTPJ) program which is based on a nation-wide alliance of selected universities and national laboratories in Japan. The mission is to promote collaborative research between academia and industry, as well as provide share-use of cutting-edge equipment and facilities to support further development of nanotechnology. &amp;#10;&amp;#10;&amp;#10;Nanotechnology Platform Japan (NTPJ) consist of three platforms including Advanced-Characterization Nanotechnology Platform, Nanofabrication Platform and Molecule and Material Synthesis Platform. It is strongly anticipated that the integration of these technologies in the field of IT, environment, energy and life science will have a significant impact on society."
    channeltitle "WebsEdge Science"
    channelid "UCQVfY-ask5eSxnoFxVLHsBw"
