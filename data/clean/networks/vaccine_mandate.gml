  node [
    id 174
    label "TXVDYtPqvxg"
    step 0
    date "2022-02-15T11:41:28Z"
    title "Fallout from the hundreds of truckers protesting Canadas vaccine mandates | Nightline"
    description "After a week of demonstrations, the Ambassador Bridge, the biggest commercial crossing between the U.S. and Canada, reopened. Experts say Michigan workers may have lost up to $51 million in wages.&#10;&#10;WATCH NIGHTLINE EPISODES:&#10;https://abc.go.com/shows/nightline &#10;&#10;ALSO AVAILABLE ON HULU: https://hulu.tv/2wSmSrZ&#10;&#10;#Nightline #Canada #Truckers #AntiVaccine"
