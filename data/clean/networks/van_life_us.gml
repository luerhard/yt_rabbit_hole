/2EGMIXL&amp;#10;&amp;#160;&amp;#160;&amp;#10;&amp;#160;&amp;#160;Double USB Port:&amp;#160;https://amzn.to/32OvFed&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;16G/2 Wire:&amp;#160;https://amzn.to/2EYkYh3&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;14G/2 Wire:&amp;#160;https://amzn.to/34VHdPp&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;10G Wire:&amp;#160;https://amzn.to/31SDqR7&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;8G Wire:&amp;#160;https://amzn.to/3gS0Ha7&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;4G Wire:&amp;#160;https://amzn.to/2EOvLKM&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;14/3 120V Wire:&amp;#160;https://amzn.to/2YWlaEI&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;Wire Loom:&amp;#160;https://amzn.to/3gS28Fx&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;Crimp Terminal Kit:&amp;#160;https://amzn.to/2QJvyuW&amp;#10;&amp;#160;&amp;#10;&amp;#10;&amp;#10;&amp;#160;&amp;#160; Kitchen, Lighting &amp;#38; Appliances&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;18 Gallon freshwater tank &amp;#38; Water Pump:&amp;#160;https://amzn.to/3hT6vl4&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;7 Gallon Grey Water Tank:&amp;#160;https://amzn.to/3lMbdDE&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;Counter Top:&amp;#160;https://www.ikea.com/us/en/p/pinnarp-countertop-ash-veneer-50372314/&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;Sink:&amp;#160;https://amzn.to/3lSAxI6&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;Faucet:&amp;#160;https://amzn.to/3jD8n1F&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;1500W Induction Stovetop:&amp;#160;https://amzn.to/2EYmwaR&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;12V 42QT Refrigerator:&amp;#160;https://amzn.to/3jBVp4j&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;Hidden Outlet:&amp;#160;https://amzn.to/3jFgCdK&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;Magnetic Drawer Latches:&amp;#160;https://amzn.to/32P9PXV&amp;#10;&amp;#160;&amp;#10;&amp;#160;&amp;#160;Touch Dimmable Light Switches:&amp;#16