  [
    id 337
    label "0GzIppFjcYY"
    step 0
    date "2019-12-05T17:59:49Z"
    title "VAN LIFE UK: Preparing to go OFF GRID FULL TIME // S03E01"
    description "In this episode, we are preparing to live the Van Life full time Off-Grid and on the move.&amp;#10;Join us as we head out to explore the UK, Liverpool, The Lake District, and the great British countryside &amp;#10;&amp;#10;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187; THANKS TO THE KOMBI CREW&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#10;&amp;#10;REAL TIME UPDATES // UNLISTED BONUS VIDEOS // LIVE HANGOUTS // EARLY ACCESS // MEET UPS // COLLABORATIONS &amp;#38; MUCH MORE available for KOMBI CREW supporters&amp;#10;&amp;#10;&amp;#10084; JOIN THE KOMBI CREW: https://www.patreon.com/kombilife &amp;#10084;&amp;#10;&amp;#10;(you can also become a channel member, it's essentially the same as Patreon)&amp;#10;&amp;#10;&amp;#10084; https://www.youtube.com/kombilife/join &amp;#10084;&amp;#10;&amp;#10;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp;#187;&amp