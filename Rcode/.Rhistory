library('dplyr')
library('ggplot2')
library('patchwork')
library('igraph')
library('tm')         # to create wordcloud
library('wordcloud')  # to create wordcloud
## load data [snowball] ----
df <- read.csv('../data/raw/roe_v_wade_max_12_test.csv')
df$id <- c(1:nrow(df))
# load data [catch all] ----
df <- read.csv('../data/raw/roe_v_wade_catch_all.csv')
df <- df[df$video_id %in% unique(df$source_video_id) & df$video_id != "",]
nodeslist <- df[,c(2:6)]
nodeslist <- nodeslist[match(unique(nodeslist$video_id), nodeslist$video_id),]
colnames(nodeslist)[1] <- c("Source")
edgelist <- df[,c(8,2)]
colnames(edgelist) <- c("Source","Target")
edgelist <- edgelist[edgelist$Source %in% nodeslist$Source, ]
edgelist <- edgelist[edgelist$Target %in% nodeslist$Source, ]
## create igraph object [catch all] ----
g <- graph_from_data_frame(edgelist, directed = TRUE, vertices = nodeslist)
components <- components(g)
g <- induced_subgraph(g, vids = V(g)[components$membership %in% which.max(components$csize)])
#cluster_optimal(g) # takes long
cluster_louvain(as.undirected(g))
library('dplyr')
library('ggplot2')
library('patchwork')
library('igraph')
library('tm')         # to create wordcloud
library('wordcloud')  # to create wordcloud
## load data [catch all] ----
df <- read.csv('../data/raw/roe_v_wade_catch_all.csv')
df <- df[df$video_id %in% unique(df$source_video_id) & df$video_id != "",]
nodeslist <- df[,c(2:6)]
nodeslist <- nodeslist[match(unique(nodeslist$video_id), nodeslist$video_id),]
colnames(nodeslist)[1] <- c("Source")
edgelist <- df[,c(8,2)]
colnames(edgelist) <- c("Source","Target")
edgelist <- edgelist[edgelist$Source %in% nodeslist$Source, ]
edgelist <- edgelist[edgelist$Target %in% nodeslist$Source, ]
## create igraph object [catch all] ----
g <- graph_from_data_frame(edgelist, directed = TRUE, vertices = nodeslist)
components <- components(g)
g <- induced_subgraph(g, vids = V(g)[components$membership %in% which.max(components$csize)])
#cluster_optimal(g) # takes long
cl <- cluster_louvain(as.undirected(g))
df <- data.frame(
video_id=nodelist$video_id,
clust=cl$membership
)
df2 <- data.frame(
video_id=nodeslist$video_id,
clust=cl$membership
)
df2 <- data.frame(
video_id=nodeslist$Source,
clust=cl$membership
)
cd
cl
cl$membership
V(g)
V(g)$cluster <- cl$membership
plot(g)
?igraph::plot
plot(g,vertex.color=V(g)$membership)
plot(g,vertex.color=V(g)$membership,label=F)
plot(g,vertex.color=V(g)$membership,label=NA)
plot(g,vertex.color=V(g)$cluster,label=NA)
plot(g, vertex.color=V(g)$cluster, vertex.label=NA)
plot(g, vertex.color=V(g)$cluster, vertex.label=NA, vertex.size=3)
plot(g, vertex.color=V(g)$cluster, vertex.label=NA, vertex.size=3, edge.size=.1)
plot(g, vertex.color=V(g)$cluster, vertex.label=NA, vertex.size=3, edge.width=.1)
