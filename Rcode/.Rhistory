plot(g, vertex.color=V(g)$cluster, vertex.label=NA, vertex.size=3, edge.arrow.size=0.3)
plot(g, vertex.color=V(g)$cluster, vertex.label=NA, vertex.size=3, edge.arrow.size=0.3)
